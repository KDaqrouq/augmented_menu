# Postgres connection strings (required for Prisma).
# DATABASE_URL is used by the app (on Supabase: the pooled connection, port 6543, add ?pgbouncer=true).
# DIRECT_URL is used by `prisma migrate` (on Supabase: the direct connection, port 5432).
DATABASE_URL="postgresql://user:password@localhost:5432/aug_reality"
DIRECT_URL="postgresql://user:password@localhost:5432/aug_reality"

# Admin auth (v1: single password gate). Required for /admin and /api/admin.
ADMIN_PASSWORD="changeme"
# Signs the admin session cookie (12 h sessions). Use a long random string, e.g. `openssl rand -hex 32`.
# Rotating it signs every admin out. If unset, a key is derived from ADMIN_PASSWORD.
SESSION_SECRET=""

# Supabase Storage for menu photos and 3D models. Bucket should be public.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="menu-images"

# Redis for the job queue and the shared login rate limit. Use rediss:// for TLS (e.g. Upstash).
# Example: redis://localhost:6379 or rediss://default:xxx@host:6379
REDIS_URL="redis://localhost:6379"

# Tripo 3D API for image-to-3D generation. Get key from Tripo platform (starts with tsk_).
TRIPO_API_KEY=""
# Optional: override base URL (default https://api.tripo3d.ai/v2/openapi)
# TRIPO_API_BASE_URL="https://api.tripo3d.ai/v2/openapi"

# Max AR asset size in MB after optimization (GLB/USDZ). Used to keep
# Supabase Storage within limits. If models exceed this even after compression,
# GLB upload will fail; USDZ will be skipped and iOS will fall back to 3D view.
MAX_ASSET_MB=25

# Enable/disable GLB compression pipeline. When set to false/0/no, models will
# be uploaded without glTF-Transform compression, but MAX_ASSET_MB will still
# be enforced. Default is true.
ENABLE_GLTF_COMPRESSION=true
